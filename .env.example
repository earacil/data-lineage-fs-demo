# Plantilla SIN secretos (se versiona). Copia a `.env` y rellena: cp .env.example .env
# `.env` está en .gitignore y no se sube a GitHub.

# --- Conexión a la instancia AuraDB (Bolt) — formato que entiende `neo4j-cli query --env .env` ---
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Aura: identificador de la instancia ---
AURA_INSTANCE_ID=

# --- Aura API (sólo cliente Python / administración de sesiones del proyecto; ver AURA_SETUP.md §5) ---
CLIENT_ID=
CLIENT_SECRET=
PROJECT_ID=

# --- Demo ---
BASE_URL=https://raw.githubusercontent.com/earacil/data-lineage-fs-demo/main/data/
SESSION_NAME=lineage-demo
SESSION_MEMORY=2GB
