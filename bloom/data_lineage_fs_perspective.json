Prop":true},{"key":"field_type_evidence","metadataProp":true}]},{"label":"EtlJob","type":"native","propertyKeys":[{"key":"id","metadataProp":false},{"key":"name","metadataProp":false},{"key":"frequency","metadataProp":true},{"key":"owning_team","metadataProp":true},{"key":"estimated_compute_cost","metadataProp":true},{"key":"status","metadataProp":true}]},{"label":"FinalConsumer","type":"native","propertyKeys":[{"key":"id","metadataProp":false},{"key":"name","metadataProp":true},{"key":"type","metadataProp":true},{"key":"regulation","metadataProp":true},{"key":"periodicity","metadataProp":true}]},{"label":null,"type":"native","propertyKeys":[]},{"label":"Owner","type":"native","propertyKeys":[{"key":"id","metadataProp":false},{"key":"name","metadataProp":true},{"key":"role","metadataProp":true}]},{"label":"SourceSystem","type":"native","propertyKeys":[{"key":"id","metadataProp":false},{"key":"name","metadataProp":true},{"key":"technology","metadataProp":true},{"key":"type","metadataProp":true},{"key":"criticality","metadataProp":true}]}]},"name":"Data Lineage FS Perspective","palette":{"colors":["#FFE081","#C990C0","#F79767","#57C7E3","#F16667","#D9C8AE","#8DCC93","#ECB5C9","#4C8EDA","#FFC454","#DA7194","#569480","#959AA1","#D9D9D9"],"currentIndex":5},"parentPerspectiveId":null,"relationshipTypes":[{"id":"FEEDS","name":"FEEDS","properties":[],"color":"#959aa1ff","size":1,"captionKeys":[],"captions":[{"inTooltip":true,"isCaption":true,"styles":[],"key":"FEEDS","type":"relationship"}],"textSize":1,"textAlign":"top","styleRules":[]},{"id":"HOSTS","name":"HOSTS","properties":[],"color":"#959aa1ff","size":1,"captionKeys":[],"captions":[{"inTooltip":true,"isCaption":true,"styles":[],"key":"HOSTS","type":"relationship"}],"textSize":1,"textAlign":"top","styleRules":[]},{"id":"MAINTAINED_BY","name":"MAINTAINED_BY","properties":[],"color":"#959aa1ff","size":1,"captionKeys":[],"captions":[{"inTooltip":true,"isCaption":true,"styles":[],"key":"MAINTAINED_BY","type":"relationship"}],"textSize":1,"textAlign":"top","styleRules":[]},{"id":"PROCESSES","name":"PROCESSES","properties":[],"color":"#959aa1ff","size":1,"captionKeys":[],"captions":[{"inTooltip":true,"isCaption":true,"styles":[],"key":"PROCESSES","type":"relationship"}],"textSize":1,"textAlign":"top","styleRules":[]},{"id":"TRANSFORMS_TO","name":"TRANSFORMS_TO","properties":[{"propertyKey":"id","type":"TRANSFORMS_TO","dataType":"string"},{"propertyKey":"scenario","type":"TRANSFORMS_TO","dataType":"string"},{"propertyKey":"transformation_expression","type":"TRANSFORMS_TO","dataType":"string"},{"propertyKey":"filters","type":"TRANSFORMS_TO","dataType":"array"},{"propertyKey":"is_synthetic_source","type":"TRANSFORMS_TO","dataType":"boolean"}],"color":"#959aa1ff","size":1,"captionKeys":[],"captions":[{"inTooltip":true,"isCaption":true,"styles":[],"key":"TRANSFORMS_TO","type":"relationship"}],"textSize":1,"textAlign":"top","styleRules":[]}],"sceneActions":[],"templates":[{"name":"Shows Jobs dependency Map with Columns","id":"tmpl:1793029947775","createdAt":1793029947775,"text":"C3a. Show Jobs dependency Map with Columns","cypher":"MATCH p = (producer:EtlJob)-[:PROCESSES]->(c:Column)<-[:PROCESSES]-(consumer:EtlJob)\nWHERE producer <> consumer\n  AND EXISTS { MATCH (:Column)-[:TRANSFORMS_TO {scenario: producer.name}]->(c) }   // producer ESCRIBE c\n  AND EXISTS { MATCH (c)-[:TRANSFORMS_TO {scenario: consumer.name}]->(:Column) }   // consumer LEE c\nRETURN p;","isUpdateQuery":false,"isWriteTransactionChecked":false,"params":[],"hasCypherErrors":false},{"name":"Shows ETLJob connections (BUILD_RWA_DENSITY)","id":"tmpl:1793029544152","createdAt":1793029544152,"text":"C1. Job $etlJob connection","cypher":"MATCH p = (new:EtlJob {name: $etlJob})-[:PROCESSES]->(c:Column)<-[:PROCESSES]-(other:EtlJob)\nWHERE other <> new\nRETURN p;","isUpdateQuery":false,"isWriteTransactionChecked":false,"params":[{"name":"$etlJob","dataType":"String","suggestions":"cypher","cypher":"MATCH (j:EtlJob)\nRETURN j.name\nORDER BY j.name;","suggestionLabel":null,"suggestionProp":null,"suggestionBoolean":false,"collapsed":false}],"hasCypherErrors":false},{"name":"Shows column lineage (REG_MART.CAPITAL.RWA_DENSITY)","id":"tmpl:1793029582147","createdAt":1793029582147,"text":"C2. Column $column lineage","cypher":"MATCH p = (root:Column)-[:TRANSFORMS_TO*1..10]->(:Column {fqn: $column})\nWHERE NOT EXISTS { ()-[:TRANSFORMS_TO]->(root) }\nRETURN p;","isUpdateQuery":false,"isWriteTransactionChecked":false,"params":[{"name":"$column","dataType":"String","suggestions":"cypher","cypher":"MATCH (c:Column)\nRETURN c.fqn\nORDER BY c.fqn;","suggestionLabel":null,"suggestionProp":null,"suggestionBoolean":false,"collapsed":false}],"hasCypherErrors":false},{"name":"Shows Jobs dependency Map (direct)","id":"tmpl:1793029610202","createdAt":1793029610202,"text":"C3b. Show Jobs dependency Map","cypher":"MATCH (producer:EtlJob)-[:PROCESSES]->(c:Column)<-[:PROCESSES]-(consumer:EtlJob)\nWHERE producer <> consumer\n  AND EXISTS { MATCH (:Column)-[:TRANSFORMS_TO {scenario: producer.name}]->(c) }\n  AND EXISTS { MATCH (c)-[:TRANSFORMS_TO {scenario: consumer.name}]->(:Column) }\nWITH producer, consumer, collect(DISTINCT c.fqn) AS shared_columns\nRETURN producer, consumer,\n       apoc.create.vRelationship(producer, 'DEPENDENCY', {shared_columns: size(shared_columns),\n                                                          sample: shared_columns[..3]}, consumer) AS dependency;","isUpdateQuery":false,"isWriteTransactionChecked":false,"params":[],"hasCypherErrors":false},{"name":"Impact produced by a change on a Query (CORE.LOAN.DRAWN_AMOUNT)","id":"tmpl:1793029632999","createdAt":1793029632999,"text":"1. Column $column impact","cypher":"MATCH lineage = (:Column {fqn: $column})-[:TRANSFORMS_TO*0..10]->(d:Column)            // ← CAMBIA\nMATCH touched_by = (j:EtlJob)-[:PROCESSES]->(d)\nOPTIONAL MATCH maintained_by = (j)-[:MAINTAINED_BY]->(:Owner)\nOPTIONAL MATCH final_customer = (d)-[:FEEDS]->(:FinalConsumer)\nRETURN lineage, touched_by, maintained_by, final_customer;","isUpdateQuery":false,"isWriteTransactionChecked":false,"params":[{"name":"$column","dataType":"String","suggestions":"cypher","cypher":"MATCH (c:Column)\nRETURN c.fqn\nORDER BY c.fqn;","suggestionLabel":null,"suggestionProp":null,"suggestionBoolean":false,"collapsed":false}],"hasCypherErrors":false},{"name":"Full path to FinalCustomer (Solvency Report)","id":"tmpl:1793029735519","createdAt":1793029735519,"text":"2. Full Path to FinalConsumer $finalConsumer","cypher":"MATCH (fc:FinalConsumer {name: $finalConsumer})\nMATCH p = (:SourceSystem)-[:HOSTS]->(root:Column)-[:TRANSFORMS_TO*0..10]->(:Column)-[:FEEDS]->(fc)\nWHERE NOT EXISTS { ()-[:TRANSFORMS_TO]->(root) }\nRETURN p;","isUpdateQuery":false,"isWriteTransactionChecked":false,"params":[{"name":"$finalConsumer","dataType":"String","suggestions":"cypher","cypher":"MATCH (fc:FinalConsumer)\nRETURN fc.name\nORDER BY fc.name;","suggestionLabel":null,"suggestionProp":null,"suggestionBoolean":false,"collapsed":false}],"hasCypherErrors":false}],"type":"STANDARD_PERSPECTIVE","version":"2.21.0","policy":{"private":true,"userRoles":[{"userId":"eea8459b-a62e-487b-a45b-607c10d55d49","roles":["roles/admin"]}]}}